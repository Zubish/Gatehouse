# Copy this to .env (DO NOT COMMIT this file). Fill with real secrets.

# Database
DATABASE_URL="postgresql://user:password@host:5432/database"

# Application secrets
JWT_SECRET="replace_with_strong_jwt_secret"
QR_SIGNING_SECRET="replace_with_qr_signing_secret"

# AI / Gemini
GEMINI_API_KEY="replace_with_gemini_api_key"      # Preferred for Gemini
# alternatively
GOOGLE_AI_API_KEY="replace_with_google_ai_api_key"

# Admin & runtime
ADMIN_PASSWORD="replace_with_admin_password"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Optional
NODE_ENV=development
PORT=3000
